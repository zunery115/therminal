.menu-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgb(12, 22, 40);
}

.menu-card {
    width: 420px;
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 28px;
    padding-right: 28px;
    background-color: rgba(10, 16, 24, 0.92);
    border-radius: 10px;
    border-left-width: 4px;
    border-left-color: rgb(90, 180, 255);
}

.panel-hidden {
    display: none;
}

.menu-title {
    font-size: 36px;
    color: rgb(230, 240, 255);
    -unity-font-style: bold;
    margin-bottom: 18px;
    -unity-text-align: middle-center;
}

.menu-button {
    height: 44px;
    margin-bottom: 10px;
    font-size: 18px;
    color: rgb(230, 240, 255);
    background-color: rgb(24, 42, 68);
    border-radius: 6px;
    border-width: 0;
}

.menu-button:hover {
    background-color: rgb(36, 64, 102);
}

.menu-line {
    font-size: 18px;
    color: rgb(210, 224, 238);
    margin-bottom: 8px;
}

.menu-note {
    font-size: 16px;
    color: rgb(120, 210, 255);
    white-space: normal;
    margin-top: 8px;
    margin-bottom: 16px;
}