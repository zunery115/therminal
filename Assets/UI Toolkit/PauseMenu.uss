.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 14, 28, 0.72);
}

.frame {
    width: 420px;
    padding-top: 36px;
    padding-bottom: 28px;
    padding-left: 32px;
    padding-right: 32px;
    align-items: center;
    background-color: rgba(16, 36, 64, 0.96);
    border-width: 2px;
    border-color: rgb(120, 190, 230);
    border-radius: 10px;
}

.title {
    font-size: 56px;
    color: rgb(214, 242, 255);
    -unity-font-style: bold;
    letter-spacing: 10px;
    margin-bottom: 28px;
}

.btn {
    width: 100%;
    height: 52px;
    margin-bottom: 10px;
    font-size: 22px;
    color: rgb(232, 246, 255);
    background-color: rgb(28, 78, 128);
    border-width: 1px;
    border-color: rgb(150, 210, 240);
    border-radius: 4px;
}

.btn:hover {
    background-color: rgb(48, 118, 176);
    color: white;
}

.btn-quiet {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(80, 120, 150);
    color: rgb(170, 200, 220);
}

.hidden {
    display: none;
}